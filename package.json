{
  "name": "temp-tailwind",
  "version": "1.0.0",
  "description": "Tailwind CSS project with PostCSS and stylelint",
  "private": true,
  "scripts": {
    "dev": "npm run build:js",
    "build": "npm run build:js && npm run audit",
    "lint:css": "stylelint --fix \"static/**/*.css\"",
    "lint": "npm run lint:css",
    "audit:html": "html-validate \"templates/**/*.html\"",
    "audit:a11y": "echo 'pa11y-ci removed'",
    "audit": "npm run audit:html && npm run audit:a11y",
    "prepare": "husky install",
    "preinstall": "npx only-allow pnpm",
    "build:js": "node scripts/minify-js.mjs"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard",
      "stylelint-config-recommended"
    ],
    "plugins": [
      "stylelint-order"
    ],
    "rules": {
      "at-rule-no-unknown": [
        true,
        {
          "ignoreAtRules": [
            "tailwind",
            "apply",
            "variants",
            "responsive",
            "screen",
            "layer",
            "base",
            "components",
            "utilities"
          ]
        }
      ],
      "order/properties-alphabetical-order": true,
      "keyframes-name-pattern": null,
      "selector-class-pattern": null,
      "declaration-block-single-line-max-declarations": null,
      "max-line-length": null,
      "declaration-block-no-duplicate-properties": null,
      "no-invalid-position-at-import-rule": null,
      "no-duplicate-selectors": null
    },
    "ignoreFiles": [
      "static/css/output.css",
      "**/templates.css"
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "html-validate": "^8.0.0",
    "husky": "^8.0.3",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^15.1.0",
    "postcss-nesting": "^13.0.2",
    "postcss-preset-env": "^10.2.4",
    "stylelint": "^15.10.3",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-order": "^6.0.3",
    "terser": "^5.28.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
